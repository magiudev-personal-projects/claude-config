{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "sk-<YOUR_ANTHROPIC_API_KEY>",
    "ANTHROPIC_MODEL": "deepseek-v4-pro"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        ".env",
        "**/.env",
        "portal-be-develop/.env"
      ]
    }
  },
  "modelSettings": {
    "deepseek-v4-pro": {
      "effortLevel": "high"
    }
  },
  "theme": "dark"
}
